# Copier vers .env (PowerShell : Copy-Item .env.example .env) puis adapter.
# Ne JAMAIS committer .env. Ne JAMAIS coller son contenu dans une conversation.
NODE_ENV=development
PORT=3000

# En développement, la valeur par défaut est mongodb://127.0.0.1:27017/pharmaloc
# En production, MONGODB_URI est OBLIGATOIRE et doit contenir des identifiants :
#   mongodb://utilisateur:mot_de_passe@hote:27017/pharmaloc?authSource=pharmaloc
# (les caractères spéciaux du mot de passe doivent être encodés pour une URL)
MONGODB_URI=mongodb://127.0.0.1:27017/pharmaloc

# Origines du frontend autorisées, séparées par des virgules (CORS et contrôle CSRF).
# En production : https uniquement, sans slash final.  Ex. : https://app.exemple.sn
ALLOWED_ORIGINS=

# Nombre de reverse proxys devant l'API (souvent 1 en production, 0 en développement).
# Sans lui, la limitation de débit croit que tous les clients ont la même adresse IP.
TRUST_PROXY=0

# Limitation de débit : active par défaut. "off" la coupe en développement ; interdit en production.
RATE_LIMIT=on