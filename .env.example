# Copier vers .env (PowerShell : Copy-Item .env.example .env) puis adapter.
# Ne JAMAIS committer .env.
NODE_ENV=development
PORT=3000
# En développement, la valeur par défaut est mongodb://127.0.0.1:27017/pharmaloc
# En production, MONGODB_URI est OBLIGATOIRE.
MONGODB_URI=mongodb://127.0.0.1:27017/pharmaloc
# Origines du frontend autorisées (séparées par des virgules), ex. http://localhost:5173
ALLOWED_ORIGINS=
